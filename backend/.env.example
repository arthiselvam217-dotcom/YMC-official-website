# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas Configuration (Set your actual connection URI in .env)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/ymc_club?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/ymc_club?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=replace_with_a_secure_random_jwt_secret_in_production
JWT_EXPIRES_IN=7d

# Nodemailer SMTP Configuration (Architecture ready - fill with credentials when ready to send)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password
EMAIL_FROM="YMC GCT" <noreply@ymcgct.org>
